# Neon pooled connection string (or a local Postgres for development)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random string of at least 32 characters used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# Shared secret the Catalyst Cron sends as the X-Scrape-Secret header
SCRAPE_SECRET=change-me

# Initial password for the seeded accounts (admin, principal, vice.chairman, hod.it).
# Development value only: replace it, or have every account change it, before real deployment.
SEED_PASSWORD=rmkec@123

# Frontend origins allowed to call the API with cookies (comma separated)
CORS_ORIGINS=http://localhost:5173

# Set to none only if the frontend and API end up on different sites (requires HTTPS)
COOKIE_SAMESITE=lax
NODE_ENV=development
PORT=3000
